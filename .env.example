# Optional generative backends. Leave both empty to answer from retrieved sentences.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# Vector database. Leave the key empty to keep vectors on this computer.
PINECONE_API_KEY=
PINECONE_INDEX=rag-chatbot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
VECTOR_STORE=auto

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=1
CHUNK_SIZE=800
CHUNK_OVERLAP=140
TOP_K=4
